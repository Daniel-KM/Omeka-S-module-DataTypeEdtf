{
    "name": "daniel-km/omeka-s-module-data-type-edtf",
    "description": "Module for Omeka S: Data type for the Extended Date/Time Format",
    "type": "omeka-s-module",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Steve Ranford",
            "email": "digitalhumanities@warwick.ac.uk"
        },
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "homepage": "https://warwick.ac.uk/digitalhumanities",
    "support": {
        "issues": "https://github.com/Daniel-KM/Omeka-S-module-DataTypeEdtf/issues",
        "forum": "https://forum.omeka.org/"
    },
    "keywords": [
        "Omeka S",
        "module",
        "data type",
        "date",
        "time",
        "edtf"
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "professional-wiki/edtf": "^3.0",
        "sempia/external-assets": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    },
    "autoload": {
        "psr-4": {
            "DataTypeEdtf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DataTypeEdtfTest\\": "tests/DataTypeEdtfTest/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "sempia/external-assets": true
        }
    },
    "extra": {
        "installer-name": "DataTypeEdtf",
        "external-assets": {
            "asset/vendor/edtf/edtf.js": "https://github.com/Daniel-KM/Omeka-S-module-DataTypeEdtf/releases/download/3.4.4/edtf.js"
        }
    }
}
