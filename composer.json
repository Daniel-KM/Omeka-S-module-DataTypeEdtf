{
    "name": "digihum/omeka-s-module-edtf-data-type",
    "description": "EDTF Data Type (module for Omeka S)",
    "type": "omeka-s-module",
    "license": "CECILL-2.1",
    "authors": [
        {
            "name": "Steve Ranford",
            "email": "digitalhumanities@warwick.ac.uk"
        }
    ],
    "homepage": "https://warwick.ac.uk/digitalhumanities",
    "support": {
        "issues": "https://github.com/digihum/omeka-s-module-edtfdatetime",
        "forum": "https://forum.omeka.org/"
    },
    "keywords": [
        "Omeka S",
        "module",
        "data type",
        "date",
        "time",
        "edtf",
        "datetime",
        "numeric"
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "professional-wiki/edtf": "^3.0",
        "sempia/external-assets": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "EdtfDataType\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EdtfDataTypeTest\\": "tests/EdtfDataTypeTest/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "sempia/external-assets": true
        }
    },
    "extra": {
        "installer-name": "EdtfDataType",
        "external-assets": {
            "asset/vendor/edtf/edtf.js": "https://github.com/Daniel-KM/Omeka-S-module-DataTypeEdtf/releases/download/3.4.4/edtf.js"
        }
    }
}
